# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
.venv/

# Lean build artifacts (Mathlib cache is fetched with `lake exe cache get`)
formal/.lake/

# Large or regenerable data
data/raw/
data/tokens/
*.bin
*.npy
!experiments/**/results/*.npy
# per-sequence validation/test losses of the TPU runs: the Phase 08 bootstrap reads them
!runs/**/val_seq_losses.npy
!runs/**/test_seq_losses.npy

# OS / editors
.DS_Store
.idea/
.vscode/

# E3.1 gradient snapshots (~100 MB each; regenerable: e27_small_lm.py --snapshots)
experiments/phase3/results/lm/snap_*.npz

# TPU runs: compilation cache, checkpoints, traces, optimized HLO, raw host logs, scratch runs
.jax_cache/
runs/**/ckpt/
runs/**/ckpt_keep/
runs/profiles/
runs/hlo/
# raw per-host logs; the driver logs (tune.log, main_runs.log, diag/*.log) feed the compute budget
runs/logs/**/host*.log
runs/dev/
